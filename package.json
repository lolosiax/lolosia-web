{
  "name": "lolosia-web",
  "version": "0.0.1-alpha",
  "license": "MIT",
  "author": "洛洛希雅Lolosia",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --mode serve-dev",
    "build": "vite build --mode build",
    "preview": "vite preview --mode build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:hard": "eslint -c eslint.hard.config.mjs .",
    "typecheck": "vue-tsc --noEmit",
    "verify": "pnpm lint && pnpm lint:hard && vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.20.0",
    "bootstrap-icons": "^1.13.2",
    "element-plus": "2.14.7",
    "gcoord": "^1.0.7",
    "gsap": "^3.15.0",
    "lunar-calendar": "^0.1.4",
    "moment-mini": "^2.29.4",
    "nprogress": "^0.2.0",
    "pinia": "4.1.0",
    "pinia-plugin-persistedstate": "4.7.1",
    "three": "^0.186.1",
    "vue": "3.5.44",
    "vue-clipboard3": "^2.0.0",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/nprogress": "^0.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@webgpu/types": "^0.1.74",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.106.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "unocss": "^66.11.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
